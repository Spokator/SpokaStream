{
  "name": "spokastream",
  "productName": "SpokaStream",
  "version": "1.6.7",
  "description": "Stream en haute qualité entre amis : un vrai logiciel, avec le son de l'application de ton choix.",
  "author": "Spokator",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Spokator/SpokaStream.git"
  },
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "npm run viewer",
    "viewer": "node scripts/build-viewer.mjs",
    "dev": "npm run viewer && electron-vite dev",
    "build": "npm run viewer && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types \"tests/unit/*.test.ts\"",
    "test:e2e": "npm run build && node --experimental-strip-types --no-warnings tests/e2e/run.ts",
    "test:party": "npm run build && node --experimental-strip-types --no-warnings tests/e2e/party.ts",
    "test:remote": "npm run build && node --experimental-strip-types --no-warnings tests/e2e/remote.ts",
    "test:capture-game": "node --experimental-strip-types --no-warnings tests/e2e/capture-game.ts",
    "test:admin-phone": "npm run viewer && node --experimental-strip-types --no-warnings tests/e2e/admin-phone.ts",
    "test:production": "npm run build && node --experimental-strip-types --no-warnings tests/e2e/production.ts",
    "test:obs": "npm run build && node --experimental-strip-types --no-warnings tests/e2e/obs.ts",
    "server": "node --experimental-strip-types server/start.ts",
    "server:build": "npm run viewer && esbuild server/start.ts --bundle --platform=node --format=esm --target=node22 --outfile=server/dist/spokastream-server.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "native": "powershell -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "dist": "npm run native && npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.65.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "hls.js": "^1.7.4",
    "lucide-preact": "^1.66.0",
    "playwright": "^1.64.1",
    "preact": "^11.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
